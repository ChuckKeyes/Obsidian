# ---- Firewall

# SSH from your admin /32
resource "google_compute_firewall" "allow_ssh" {
  name    = "allow-ssh-admin"
  network = google_compute_network.net.name

  allow {
    protocol = "tcp"
    ports    = ["22"]
  }

  source_ranges = [var.admin_cidr]
}

# ICMP from your admin /32 (ping from home/office)
resource "google_compute_firewall" "allow_icmp_admin" {
  name    = "allow-icmp-admin"
  network = google_compute_network.net.name

  allow {
    protocol = "icmp"
  }

  source_ranges = [var.admin_cidr]
}

# ICMP within the VPC subnet (VM ↔ VM)
resource "google_compute_firewall" "allow_icmp_internal" {
  name    = "allow-icmp-internal"
  network = google_compute_network.net.name

  allow {
    protocol = "icmp"
  }

  source_ranges = [google_compute_subnetwork.subnet.ip_cidr_range]
}
