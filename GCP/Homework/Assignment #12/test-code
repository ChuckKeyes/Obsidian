############################################
# main.tf  — Terraform BigQuery demo
############################################

terraform {
  required_version = ">= 1.5.0"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

provider "google" {
  project = var.project_id
  region  = var.region
}

# --- Enable required APIs (idempotent) ---
resource "google_project_service" "services" {
  for_each = toset([
    "bigquery.googleapis.com",
    "storage.googleapis.com"
  ])
  project = var.project_id
  service = each.key
  disable_on_destroy = false
}

# --- Unique bucket name suffix ---
resource "random_id" "suffix" {
  byte_length = 3
}

# --- GCS Bucket (force_destroy deletes objects on destroy) ---
resource "google_storage_bucket" "bucket" {
  name          = "bq-demo-${random_id.suffix.hex}"
  location      = var.gcs_location         # e.g. "US"
  force_destroy = true

  depends_on = [google_project_service.services]
}

# --- Upload 3 CSV files from local ./data/ ---
# Place your CSVs at ./data/file1.csv, ./data/file2.csv, ./data/file3.csv
resource "google_storage_bucket_object" "csv1" {
  name   = "file1.csv"
  bucket = google_storage_bucket.bucket.name
  source = "${path.module}/data/file1.csv"
}
resource "google_storage_bucket_object" "csv2" {
  name   = "file2.csv"
  bucket = google_storage_bucket.bucket.name
  source = "${path.module}/data/file2.csv"
}
resource "google_storage_bucket_object" "csv3" {
  name   = "file3.csv"
  bucket = google_storage_bucket.bucket.name
  source = "${path.module}/data/file3.csv"
}

# --- BigQuery dataset (delete contents on destroy) ---
resource "google_bigquery_dataset" "ds" {
  dataset_id                  = "demo_ds"
  location                    = var.bq_location  # e.g. "US"
  delete_contents_on_destroy  = true

  depends_on = [google_project_service.services]
}

# --- Table loaded from the 3 CSVs (autodetect schema) ---
# This uses a load JOB (one-off) to create & fill table demo_ds.raw_all
resource "google_bigquery_job" "load_raw_all" {
  job_id = "load-raw-all-${random_id.suffix.hex}"

  location = var.bq_location

  load {
    source_uris = [
      "gs://${google_storage_bucket.bucket.name}/${google_storage_bucket_object.csv1.name}",
      "gs://${google_storage_bucket.bucket.name}/${google_storage_bucket_object.csv2.name}",
      "gs://${google_storage_bucket.bucket.name}/${google_storage_bucket_object.csv3.name}",
    ]
    destination_table {
      project_id = var.project_id
      dataset_id = google_bigquery_dataset.ds.dataset_id
      table_id   = "raw_all"
    }
    source_format        = "CSV"
    autodetect           = true
    write_disposition    = "WRITE_TRUNCATE"
    field_delimiter      = ","
    skip_leading_rows    = 1         # set to 0 if no header row
    allow_quoted_newlines = true
  }

  depends_on = [
    google_storage_bucket_object.csv1,
    google_storage_bucket_object.csv2,
    google_storage_bucket_object.csv3
  ]
}

# --- OPTIONAL: make a view for easy querying without jobs ---
# (Not required, but handy.)
resource "google_bigquery_table" "v_raw_preview" {
  dataset_id = google_bigquery_dataset.ds.dataset_id
  table_id   = "v_raw_preview"
  view {
    query          = "SELECT * FROM `${var.project_id}.${google_bigquery_dataset.ds.dataset_id}.raw_all` LIMIT 100"
    use_legacy_sql = false
  }
  deletion_protection = false
}

# --- Query #1: write results to a table ---
resource "google_bigquery_job" "query1" {
  job_id  = "query1-${random_id.suffix.hex}"
  location = var.bq_location

  query {
    query = <<-SQL
      -- Example: simple projection/filter; replace with your SQL
      SELECT *
      FROM `${var.project_id}.${google_bigquery_dataset.ds.dataset_id}.raw_all`
      WHERE TRUE
    SQL

    use_legacy_sql = false
    destination_table {
      project_id = var.project_id
      dataset_id = google_bigquery_dataset.ds.dataset_id
      table_id   = "query1_result"
    }
    write_disposition = "WRITE_TRUNCATE"
  }

  depends_on = [google_bigquery_job.load_raw_all]
}

# --- Query #2: another result table ---
resource "google_bigquery_job" "query2" {
  job_id  = "query2-${random_id.suffix.hex}"
  location = var.bq_location

  query {
    query = <<-SQL
      -- Example aggregation; replace with your SQL
      SELECT COUNT(*) AS row_count
      FROM `${var.project_id}.${google_bigquery_dataset.ds.dataset_id}.raw_all`
    SQL

    use_legacy_sql = false
    destination_table {
      project_id = var.project_id
      dataset_id = google_bigquery_dataset.ds.dataset_id
      table_id   = "query2_result"
    }
    write_disposition = "WRITE_TRUNCATE"
  }

  depends_on = [google_bigquery_job.load_raw_all]
}

# --- Helpful outputs ---
output "bucket_name"     { value = google_storage_bucket.bucket.name }
output "dataset_id"      { value = google_bigquery_dataset.ds.dataset_id }
output "tables_created"  { value = ["raw_all", "query1_result", "query2_result", "v_raw_preview (view)"] }

############################################
# variables.tf
############################################
variable "project_id" { type = string }
variable "region"     { type = string  default = "us-central1" }
variable "gcs_location" { type = string default = "US" }   # GCS bucket location
variable "bq_location"  { type = string default = "US" }   # BigQuery dataset/job location

