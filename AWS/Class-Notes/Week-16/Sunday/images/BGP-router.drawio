        <mxCell id="FbTIEm-esc--6Wbo8Aqy-58" value="&#xa;&lt;div style=&quot;color: #f8f8f2;background-color: #282a36;font-family: Consolas, &#39;Courier New&#39;, monospace;font-weight: normal;font-size: 14px;line-height: 19px;white-space: pre;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;DC Router (Hub) — Routing Table (Network → Next Hop)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;Destination Network Next Hop&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;10.0.0.0/24 (DC LAN) &amp;nbsp; &amp;nbsp;Connected&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;10.10.10.0/24 (Brazil LAN) &amp;nbsp;10.200.0.2&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;10.20.20.0/24 (Italy LAN) &amp;nbsp; 10.200.0.6&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;10.30.30.0/24 (Japan LAN) &amp;nbsp; 10.200.0.10&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;10.40.40.0/24 (Philippines LAN) 10.200.0.14&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;10.50.50.0/24 (Thailand LAN) &amp;nbsp; &amp;nbsp;10.200.0.18&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&#xa;&#xa;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="875" y="61.5" width="400" height="180" as="geometry" />
        </mxCell>
        <mxCell id="FbTIEm-esc--6Wbo8Aqy-59" value="&#xa;&lt;div style=&quot;color: #f8f8f2;background-color: #282a36;font-family: Consolas, &#39;Courier New&#39;, monospace;font-weight: normal;font-size: 14px;line-height: 19px;white-space: pre;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;Philippines has 3 neighbors (DC, Japan, Thailand)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;Destination Network Next Hop&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;10.40.40.0/24 (PH LAN) &amp;nbsp;Connected&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;10.200.0.12/30 (PH–DC link) Connected&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;10.200.0.20/30 (PH–JP link) Connected&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;10.200.0.24/30 (PH–TH link) Connected&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;10.0.0.0/24 (DC LAN) &amp;nbsp; &amp;nbsp;10.200.0.13&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;10.10.10.0/24 (Brazil LAN) &amp;nbsp;10.200.0.13 (via DC)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;10.20.20.0/24 (Italy LAN) &amp;nbsp; 10.200.0.13 (via DC)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;10.30.30.0/24 (Japan LAN) &amp;nbsp; 10.200.0.21 (direct JP link)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #f8f8f2;&quot;&gt;10.50.50.0/24 (Thailand LAN) &amp;nbsp; &amp;nbsp;10.200.0.26 (direct TH link)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&#xa;&#xa;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
