
    .slideshow {
      width: 90%;
      max-width: 900px;
      height: 500px;
      position: relative;
      overflow: hidden;
      border-radius: 14px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.4);
      background: #000;
    }

     .slideshow img {
      position: absolute;
      width: 100%;
      height: 100%;
      object-fit: contain;
      opacity: 0;
      transition: opacity 1s ease-in-out;
      background: #000;
    }