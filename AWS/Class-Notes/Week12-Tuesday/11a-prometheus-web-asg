resource "aws_security_group" "targets_sg" {
  # ... existing rules ...

  # Allow Prometheus SG on port 9100
  ingress {
    description     = "node_exporter from Prometheus VM"
    from_port       = 9100
    to_port         = 9100
    protocol        = "tcp"
    security_groups = [module.prometheus_vm[0].prometheus_sg_id] # OR aws_security_group.prometheus_sg.id if kept in root
  }
}
